# True Love Server Configuration Example
# ============================================
#
# This file is shared by every machine that runs the server: it holds only the
# secrets and addresses that are the same everywhere.
#
# What differs per bot is NOT here. It lives in the database of each server and
# is changed in the admin console ("设置" tab), taking effect immediately:
#   - 本机回调地址        the address AI uses to reach this server
#   - 每日摸鱼推送的群    groups that get the 09:05 (Asia/Shanghai) push
#   - 美国摸鱼推送的群    groups that get the 08:00 (America/Chicago) push
#
# Who the master is, is known only to base (see true-love-base/config.yaml.example).

# Base service address (base 服务地址). Base runs on the same machine as the server.
base_server:
  hosts:
    wechat: "http://host.docker.internal:5000"
    lark: ""

# AI service address (AI 服务地址)
ai_service:
  host: "http://localhost:8089"

# Tokens accepted by this server; the first one is also used when calling AI
http_token: ["your_secret_token"]

# ALAPI configuration (早报等 API)
alapi:
  token: "your_alapi_token"

# Loki configuration (直接访问 Grafana Cloud Loki，同时用于日志主动上报与查询)
loki:
  # 是否启用日志主动推送到 Loki（true 时本服务日志会实时 push 上去）
  enable: true
  # Grafana Cloud Loki 地址 (在 Grafana Cloud -> Loki -> Details 中查看)
  loki_url: "https://logs-prod-xxx.grafana.net"
  # Grafana Cloud User ID (在 Grafana Cloud 账号设置中查看)
  user_id: "123456"
  # Grafana Cloud API Key (创建时选择 MetricsPublisher 或 logs:read 权限)
  # 获取方式: Grafana Cloud -> Access Policies -> Create access policy -> Add token
  api_key: "glc_xxxxx"
  # 要查询的服务列表 (对应日志的 service_name label)
  services: ["tl-ai", "tl-base", "tl-server"]

# HTTP service configuration
http:
  host: "0.0.0.0"
  port: 8088
