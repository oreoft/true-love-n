# True Love Base Configuration
# Copy this file to config.yaml and modify as needed

# This file is shared by every machine that runs base. The only per-machine entry is the master:
# the nickname that gets startup/shutdown notices, and everything sent with is_master.
# Keys are Windows machine names (any letter case); a machine that is not listed has no master.
master_wix:
  win10-m8s: "your_friend_nickname"
  another-machine: "another_nickname"

# HTTP token for authentication with backend server
http_token: "your_secret_token"

# Server address (optional). Defaults to the server container on this machine via Docker Desktop.
server:
  host: "http://host.docker.internal:8088"

# Chat listeners are read from listen_chats.json in the base working directory at startup.
# The file is NOT created automatically; base only reads it, the server writes it
# (it is linked into the server container by docker-compose).
# Format: ["好友昵称", "群名称"]
#
# To start listening to a chat right away without restarting:
#   POST /listen/add  - {"nickname": "xxx"}

# Loki log shipping (optional). Leave enable: false to log to the console only.
loki:
  enable: false
  loki_url: "https://your-loki-host"  # /loki/api/v1/push is appended automatically
  user_id: "your_loki_user_id"
  api_key: "your_loki_api_key"
